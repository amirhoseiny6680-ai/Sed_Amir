import datetime
import time
import requests
import schedule

BOT_TOKEN = "8934492635:AAF9ipJHRsukI6hOUrbCjSrIMyXevtNdMY"
CHAT_ID = "413847422"


def send_telegram_message(text):
    url = f"https://api.telegram.org/bot{BOT_TOKEN}/sendMessage"
    payload = {
        "chat_id": CHAT_ID,
        "text": text,
        "parse_mode": "Markdown",
        "disable_web_page_preview": True,
    }
    try:
        res = requests.post(url, json=payload, timeout=15)
        print(f"Sent status: {res.status_code}")
    except Exception as e:
        print(f"Error: {e}")


def daily_stock_report_1300():
    now_str = datetime.datetime.now().strftime("%Y/%m/%d %H:%M")
    report = f"""📊 *گزارش رصد روزانه بورس تهران - ساعت ۱۳:۰۰*
📅 تاریخ و ساعت: {now_str}

━━━━━━━━━━━━━━━━━━━━
📌 *۱. تابلوخوانی و جریان نقدینگی:*
• وضعیت شاخص کل و شاخص هم‌وزن
• ارزش معاملات خرد سهام و تراز پول حقیقی

🔍 *۲. فیلتر پول هوشمند و تکنیکال:*
• نمادهای دارای حجم مشکوک و ورود پول هوشمند
• شکست‌های معتبر کیجون‌سن و ساختار کومو

📈 *۳. فیلتر ترکیبی هفتگی کاپاک و KST:*
▫️ *فاز ۱ (پیش‌سیگنال):* چرخش کاپاک زیر صفر + کراس صعودی KST
▫️ *فاز ۲ (تایید روند):* عبور کاپاک از صفر به بالا
▫️ *فاز ۳ (سوپرگاوی):* هر دو اندیکاتور بالای صفر با شتاب مثبت
━━━━━━━━━━━━━━━━━━━━"""
    send_telegram_message(report)


def daily_funds_report_1900():
    now_str = datetime.datetime.now().strftime("%Y/%m/%d %H:%M")
    report = f"""🥇 *گزارش رصد اختصاصی صندوق‌ها و طلا - ساعت ۱۹:۰۰*
📅 تاریخ و ساعت: {now_str}

━━━━━━━━━━━━━━━━━━━━
🪙 *۱. صندوق‌های طلا:*
• وضعیت انس جهانی و دلار فردایی/نقدی
• حباب‌سنجی صندوق‌های طلا (کهربا، طلا، عیار، زر و ...)

⚡️ *۲. صندوق‌های سهامی و اهرمی:*
• وضعیت صندوق آتیه مفید (IRTKMOFD0001)
• جریان نقدینگی صندوق‌های اهرمی و بخشی

📊 *۳. وضعیت هفتگی اندیکاتورهای چرخه‌ای:*
• واگرایی‌ها و سیگنال‌های هفتگی کاپاک در صندوق‌ها
━━━━━━━━━━━━━━━━━━━━"""
    send_telegram_message(report)


# زمان‌بندی روزهای کاری (شنبه تا چهارشنبه)
work_days = ["saturday", "sunday", "monday", "tuesday", "wednesday"]
for day in work_days:
    getattr(schedule.every(), day).at("09:30").do(
        daily_stock_report_1300
    )  # معادل 13:00 تهران در سرورهای UTC
    getattr(schedule.every(), day).at("15:30").do(
        daily_funds_report_1900
    )  # معادل 19:00 تهران در سرورهای UTC

print("Robot Scheduler running on Render...")

# ارسال یک پیام تستی اولیه در لحظه شروع به کار
send_telegram_message("✅ ربات رصد بازار در پلتفرم Render با موفقیت فعال شد.")

while True:
    schedule.run_pending()
    time.sleep(30)
